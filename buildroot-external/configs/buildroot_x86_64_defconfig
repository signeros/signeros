################################################################################
# SignerOS — Buildroot defconfig
#
# Target : x86_64, UEFI boot, diskless, RAM-only (initramfs)
# Init   : BusyBox init, no systemd, no getty, no login
# GUI    : Qt5 Widgets on the KMS/DRM framebuffer (linuxfb QPA), no X11/Wayland
# Crypto : libwally-core, statically linked into the signer binary
#
# Use with:
#   make BR2_EXTERNAL=<repo>/buildroot-external buildroot_x86_64_defconfig
################################################################################

BR2_x86_64=y

#
# Toolchain. glibc (Qt needs NPTL + wchar); C++ for the kiosk.
#
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_AS_KERNEL=y

#
# Build posture: bit-identical rebuilds, and the smallest footprint that is
# actually safe to build. Every byte of the rootfs is permanently resident
# physical memory, so -Os is tempting here - do not take it.
#
# BR2_OPTIMIZE_S=y does NOT work: glibc fails to link with
#
#   libc_pic.os.clean: in function `__modf_sse41':
#     undefined reference to `__trunc'
#
# Why: glibc's x86-64 multiarch modf variants are compiled with -msse4.1/-mavx,
# which makes USE_TRUNC_BUILTIN true, so the source calls trunc(). GCC folds
# that to a single roundsd instruction at -O1 and -O2, but at -Os it decides the
# inline form costs size and emits a call instead - to __trunc, which lives in
# libm, while these objects land in libc. Buildroot passes -Os straight through
# to glibc (its glibc.mk only special-cases -O0 and -Ofast), so the failure
# arrives about two minutes into a fresh build.
#
# The kiosk itself is still built for size: src/btc_signer_gui/CMakeLists.txt
# sets CMAKE_BUILD_TYPE=MinSizeRel, and CMake appends its -Os after the
# toolchain's -O2, so the signer binary keeps -Os regardless of this line.
# Qt and the C library do move to -O2 and get a few percent bigger; the ESP
# payload report printed by post-image.sh is the number to watch.
BR2_OPTIMIZE_2=y
BR2_REPRODUCIBLE=y
BR2_STRIP_strip=y
BR2_ENABLE_LOCALE_PURGE=y
BR2_ENABLE_LOCALE_WHITELIST="C en_US"
# BR2_SYSTEM_ENABLE_NLS is not set

#
# Userspace hardening: stack protector, full RELRO+BIND_NOW, _FORTIFY_SOURCE=2.
#
BR2_SSP_STRONG=y
BR2_RELRO_FULL=y
BR2_FORTIFY_SOURCE_2=y

#
# System configuration. No root password, no getty, no login prompt at all:
# the only interactive surface on the device is the signer GUI.
#
BR2_TARGET_GENERIC_HOSTNAME="signeros"
BR2_TARGET_GENERIC_ISSUE="SignerOS air-gapped PSBT signer"
BR2_TARGET_GENERIC_ROOT_PASSWD="*"
BR2_INIT_BUSYBOX=y
# Device nodes: devtmpfs only.
#
# NOT ..._DYNAMIC_MDEV, despite the fact that we do use BusyBox mdev. Buildroot's
# kernel fixup does `KCONFIG_ENABLE_OPT(CONFIG_NET)` for the mdev choice - it
# assumes mdev wants netlink for hotplug - and that fixup runs AFTER our kernel
# fragment is merged, so it silently re-enabled the entire network stack. The
# irony is exact: mdev was chosen precisely because there is no network stack.
#
# We do not need the mdev choice. It only adds /etc/init.d/S10mdev (which pokes
# /proc/sys/kernel/hotplug - blocked here anyway by
# CONFIG_STATIC_USERMODEHELPER_PATH="") and a stock /etc/mdev.conf that our
# overlay overrides. The mdev applet itself is enabled by board/signeros/
# busybox.fragment, and S00early runs `mdev -s` to apply /etc/mdev.conf.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_ROOTFS_MERGED_USR=y
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set

BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_SIGNEROS_PATH)/board/signeros/users.table"
# Buildroot's default permission table, plus the two static device nodes that
# BusyBox init needs before it can mount devtmpfs on /dev (an initramfs gets
# no CONFIG_DEVTMPFS_MOUNT).
BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt $(BR2_EXTERNAL_SIGNEROS_PATH)/board/signeros/device_table.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SIGNEROS_PATH)/board/signeros/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_SIGNEROS_PATH)/board/signeros/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_SIGNEROS_PATH)/board/signeros/post-image.sh"

#
# Kernel. In-tree x86_64 defconfig as the base, then the SignerOS hardening
# fragment on top (CONFIG_NET=n, IOMMU forced on, KMS only, no internal
# storage drivers, no modules). See board/signeros/linux_hardening_defconfig.
#
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SIGNEROS_PATH)/board/signeros/linux_hardening_defconfig"
BR2_LINUX_KERNEL_BZIMAGE=y
# Kernel image compression. This compresses the built-in initramfs too - see
# section 2a of board/signeros/linux_hardening_defconfig for why the initramfs
# is left uncompressed and this single xz pass covers both. Switch to
# BR2_LINUX_KERNEL_ZSTD=y to trade a couple of MiB of ESP payload for a much
# faster kernel link, which every rootfs change now pays for.
BR2_LINUX_KERNEL_XZ=y
# objtool needs libelf, and x86_64_defconfig turns on the ORC unwinder that
# needs objtool. Building these host tools costs a few minutes; not building
# them costs a confusing kernel build failure on any host without elfutils.
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

#
# Root filesystem: a cpio linked into the kernel image, unpacked into RAM at
# boot. No block-based rootfs image is generated at all, so there is nothing on
# the USB stick that the running system could write back to.
#
# BR2_TARGET_ROOTFS_INITRAMFS is what makes this a unified kernel image: it
# points CONFIG_INITRAMFS_SOURCE at images/rootfs.cpio and rebuilds the kernel
# once the cpio exists, so the signed bzImage contains the whole root
# filesystem. The cpio itself is left UNCOMPRESSED (no BR2_TARGET_ROOTFS_CPIO_XZ
# here) because the kernel compresses it along with everything else.
#
# The cost of this is real and worth stating: every change under src/ or the
# rootfs overlay now relinks and recompresses the kernel, so `make app` is
# minutes rather than seconds.
#
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set

#
# Bootloader: none.
#
# The kernel's EFI stub makes bzImage a PE binary that UEFI executes directly,
# so post-image.sh installs it as EFI/BOOT/bootx64.efi and there is no second
# stage to configure, lock down or sign. GRUB used to live here; it was removed
# because a bootloader that loads an unverified kernel and initramfs off a FAT
# partition is exactly the gap Secure Boot is supposed to close.

#
# BusyBox: default config plus a fragment that removes every networking
# applet from the binary and adds blkid/setuidgid.
#
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SIGNEROS_PATH)/board/signeros/busybox.fragment"

#
# Qt5: gui + widgets on linuxfb only. No network, no dbus, no sql, no icu,
# no image formats, no fontconfig (fonts come from QT_QPA_FONTDIR).
#
BR2_PACKAGE_QT5=y
BR2_PACKAGE_QT5BASE=y
BR2_PACKAGE_QT5BASE_GUI=y
BR2_PACKAGE_QT5BASE_WIDGETS=y
BR2_PACKAGE_QT5BASE_LINUXFB=y
BR2_PACKAGE_QT5BASE_DEFAULT_QPA="linuxfb"
# BR2_PACKAGE_QT5BASE_NETWORK is not set
# BR2_PACKAGE_QT5BASE_DBUS is not set
# BR2_PACKAGE_QT5BASE_SQL is not set
# BR2_PACKAGE_QT5BASE_ICU is not set
# BR2_PACKAGE_QT5BASE_XCB is not set
# BR2_PACKAGE_QT5BASE_FONTCONFIG is not set
# BR2_PACKAGE_QT5BASE_EXAMPLES is not set
BR2_PACKAGE_DEJAVU=y

#
# SignerOS applications
#
BR2_PACKAGE_LIBWALLY_CORE=y
BR2_PACKAGE_BTC_SIGNER_GUI=y
BR2_PACKAGE_BTC_SIGNER_GUI_NETWORK="mainnet"
BR2_PACKAGE_BTC_SIGNER_GUI_WORD_SUGGESTIONS=y

#
# Host tools. genimage/dosfstools/mtools assemble the two-partition GPT
# image; host-qemu + the EDK2 firmware it ships give scripts/test_in_qemu.sh
# a self-contained UEFI test bed with no system packages required.
#
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_QEMU=y
BR2_PACKAGE_HOST_QEMU_SYSTEM_MODE=y
