config BR2_PACKAGE_LIBWALLY_CORE
	bool "libwally-core"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_MMU
	select BR2_PACKAGE_HOST_PKGCONF
	help
	  libwally-core is a cross-platform, primitive wallet library
	  used by SignerOS for all Bitcoin cryptography: BIP32/39
	  key derivation, BIP143/BIP341 sighash computation, RFC6979
	  deterministic ECDSA signing and BIP174/BIP370 PSBT parsing
	  and serialisation.

	  SignerOS builds it as a static archive only, so the signing
	  code is linked directly into btc_signer_gui and there is no
	  loadable crypto object on the image that could be swapped.

	  https://github.com/ElementsProject/libwally-core

comment "libwally-core needs a toolchain w/ threads"
	depends on BR2_USE_MMU
	depends on !BR2_TOOLCHAIN_HAS_THREADS
