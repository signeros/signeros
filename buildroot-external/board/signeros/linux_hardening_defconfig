# ------------------------------------------------------------------------------
# 5a. Laptop touchpads: the transports the panel devices actually hang off
#
# The list above is enough for a desktop - a PS/2 or USB keyboard and a USB
# mouse - and it is exactly what produced the first bring-up failure on real
# hardware: the keyboard worked (atkbd on i8042) and the touchpad did not exist
# at all, because on every laptop built in roughly the last decade the touchpad
# is not on the i8042 controller. It is one of:
#
#   * HID over I2C     - an ACPI-declared device on an Intel LPSS or AMD MP2
#                        I2C controller, raising a GPIO interrupt. Needs
#                        i2c-hid-acpi + the I2C host driver + pinctrl/GPIOLIB.
#                        This is the common case on anything modern.
#   * Synaptics RMI4   - PS/2 for detection, then the real protocol over SMBus
#                        (i2c-i801). Needs RMI4_CORE + RMI4_SMB.
#   * Elan / Elantech  - either PS/2 (MOUSE_PS2_ELANTECH) or I2C
#                        (MOUSE_ELAN_I2C).
#
# CONFIG_PINCTRL was off entirely, which is the load-bearing part: without a
# pin controller there is no GPIO interrupt for an I2C-HID device to signal on,
# so i2c-hid probes and then never reports an event even when everything else
# is present.
#
# This is a deliberate widening of the driver surface. It is bounded: no new
# bus is exposed to the outside of the machine (I2C/SMBus here reach only
# on-board devices), and nothing here can enumerate over USB. If you know the
# exact model this image runs on, trim this block down to that machine's
# touchpad - `cat /proc/bus/input/devices` on the target names it.
# ------------------------------------------------------------------------------
CONFIG_PINCTRL=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_ACPI=y
CONFIG_PINCTRL_INTEL=y
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_PINCTRL_BAYTRAIL=y
CONFIG_PINCTRL_CHERRYVIEW=y
CONFIG_PINCTRL_BROXTON=y
CONFIG_PINCTRL_GEMINILAKE=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_PINCTRL_CANNONLAKE=y
CONFIG_PINCTRL_ICELAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_LAKEFIELD=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_ELKHARTLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_METEORPOINT=y
CONFIG_PINCTRL_AMD=y

# I2C host controllers the touchpad can hang off. I2C_I801 (already on for
# SMBus) covers RMI4; the LPSS/Designware and AMD MP2 controllers are what
# carry I2C-HID.
CONFIG_COMMON_CLK=y
CONFIG_MFD_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_I2C_AMD_MP2=y

# HID over I2C. I2C_HID was already on but had no transport driver, which is
# indistinguishable from "not enabled" at runtime.
CONFIG_I2C_HID=y
CONFIG_I2C_HID_CORE=y
CONFIG_I2C_HID_ACPI=y

# Native touchpad protocols.
CONFIG_MOUSE_PS2_ELANTECH=y
CONFIG_MOUSE_PS2_ELANTECH_SMBUS=y
CONFIG_MOUSE_ELAN_I2C=y
CONFIG_MOUSE_ELAN_I2C_I2C=y
