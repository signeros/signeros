# ==============================================================================
# 10. TIME, ENTROPY, MISC
#
# RTC only exists so signed_<timestamp>.psbt gets a sensible filename. Note
# that ECDSA signing itself needs no entropy: libwally uses RFC6979
# deterministic nonces, so a cold or lying RNG cannot leak a private key
# through a biased k. /dev/urandom is used only to blind the secp256k1
# context against side channels.
# ==============================================================================
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_HW_RANDOM=y
# CONFIG_RANDOM_TRUST_CPU no longer exists; the equivalent is the
# random.trust_cpu= kernel command line parameter.
# CONFIG_RANDOM_TRUST_BOOTLOADER is not set
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FUTEX=y
CONFIG_SHMEM=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
