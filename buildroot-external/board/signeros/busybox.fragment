# SignerOS BusyBox configuration fragment
#
# Merged over Buildroot's default busybox.config. The point of the first
# section is that the shipped binary contains no network client, server or
# configuration applet at all. The kernel has no network stack either, so
# these would only ever be tools for an attacker who got code execution.

# --- Applets removed: networking ---
# CONFIG_ARP is not set
# CONFIG_ARPING is not set
# CONFIG_BRCTL is not set
# CONFIG_DNSD is not set
# CONFIG_ETHER_WAKE is not set
# CONFIG_FTPD is not set
# CONFIG_FTPGET is not set
# CONFIG_FTPPUT is not set
# CONFIG_HOSTNAME is not set
# CONFIG_HTTPD is not set
# CONFIG_IFCONFIG is not set
# CONFIG_IFENSLAVE is not set
# CONFIG_IFPLUGD is not set
# CONFIG_IFUPDOWN is not set
# CONFIG_INETD is not set
# CONFIG_IP is not set
# CONFIG_IPADDR is not set
# CONFIG_IPCALC is not set
# CONFIG_IPLINK is not set
# CONFIG_IPNEIGH is not set
# CONFIG_IPROUTE is not set
# CONFIG_IPRULE is not set
# CONFIG_IPTUNNEL is not set
# CONFIG_NAMEIF is not set
# CONFIG_NBDCLIENT is not set
# CONFIG_NC is not set
# CONFIG_NETSTAT is not set
# CONFIG_NSLOOKUP is not set
# CONFIG_NTPD is not set
# CONFIG_PING is not set
# CONFIG_PING6 is not set
# CONFIG_PSCAN is not set
# CONFIG_ROUTE is not set
# CONFIG_SENDMAIL is not set
# CONFIG_SLATTACH is not set
# CONFIG_SSL_CLIENT is not set
# CONFIG_TCPSVD is not set
# CONFIG_TELNET is not set
# CONFIG_TELNETD is not set
# CONFIG_TFTP is not set
# CONFIG_TFTPD is not set
# CONFIG_TRACEROUTE is not set
# CONFIG_TRACEROUTE6 is not set
# CONFIG_TUNCTL is not set
# CONFIG_UDHCPC is not set
# CONFIG_UDHCPC6 is not set
# CONFIG_UDHCPD is not set
# CONFIG_UDPSVD is not set
# CONFIG_VCONFIG is not set
# CONFIG_WGET is not set
# CONFIG_WHOIS is not set
# CONFIG_ZCIP is not set

# --- Applets removed: remote/privilege surfaces we have no use for ---
# CONFIG_CRONTAB is not set
# CONFIG_CROND is not set
# CONFIG_INIT_TERMINAL_TYPE is not set
# CONFIG_LOGIN is not set
# CONFIG_SU is not set
# CONFIG_SULOGIN is not set
# CONFIG_PASSWD is not set
# CONFIG_ADDUSER is not set
# CONFIG_DELUSER is not set
# CONFIG_ADDGROUP is not set
# CONFIG_DELGROUP is not set
# CONFIG_INSMOD is not set
# CONFIG_RMMOD is not set
# CONFIG_LSMOD is not set
# CONFIG_MODPROBE is not set
# CONFIG_DEPMOD is not set
# CONFIG_MODINFO is not set
# CONFIG_SYSLOGD is not set
# CONFIG_KLOGD is not set
# CONFIG_LOGGER is not set
# CONFIG_INETD_SUPPORT_BUILTIN_ECHO is not set

# --- Applets required by SignerOS init ---
# blkid: how S01mount-data finds the partition labelled PSBT_DATA without
#        udev (there is no netlink, so there is no udev).
CONFIG_BLKID=y
CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_VOLUMEID=y
CONFIG_FEATURE_VOLUMEID_FAT=y
CONFIG_FEATURE_VOLUMEID_EXFAT=y
# setuidgid: drops the GUI to the `signer` account without a setuid binary.
CONFIG_SETUIDGID=y
CONFIG_CHPST=y
CONFIG_MDEV=y
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_RENAME=y
CONFIG_FEATURE_MDEV_EXEC=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_FEATURE_MOUNT_LABEL=y
CONFIG_UMOUNT=y
CONFIG_FEATURE_UMOUNT_ALL=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_DMESG=y
CONFIG_CHVT=y
CONFIG_SETFONT=y
CONFIG_FSTRIM=n
CONFIG_SYNC=y
CONFIG_START_STOP_DAEMON=y
CONFIG_FEATURE_START_STOP_DAEMON_FANCY=y
